{
  "name": "minecraft_cmd_cli",
  "private": false,
  "version": "0.0.0",
  "description": "Generate Minecraft Java Edition command on CLI.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "bin": {
    "Minecraft_cmd_CLI": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "dev": "ts-node --esm src/index.ts",
    "generate-blocks": "ts-node scripts/generate-blocks.ts",
    "start": "pnpm check@fix && pnpm build && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint@fix": "biome lint --write .",
    "lint-staged": "lint-staged",
    "format": "biome format --write .",
    "check": "biome check .",
    "check@fix": "biome check --write .",
    "check@fix-unsafe": "biome check --write --unsafe",
    "export_list": "tsx .\\export_mc_list.ts"
  },
  "keywords": [
    "cli",
    "scaffold",
    "typescript",
    "generator"
  ],
  "author": "zibasan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zibasan/minecraft-cmd-cli.git"
  },
  "bugs": {
    "url": "https://github.com/zibasan/minecraft-cmd-cli/issues"
  },
  "homepage": "https://github.com/zibasan/minecraft-cmd-cli#readme",
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "clipboardy": "^5.3.1",
    "commander": "^14.0.3",
    "enquirer": "^2.4.1",
    "figures": "^6.1.0",
    "inquirer": "^13.3.0",
    "log-symbols": "^7.0.1",
    "minecraft-data": "^3.105.0",
    "node-notifier": "^10.0.1",
    "ora": "^9.3.0",
    "yargs": "^18.0.0",
    "zalgo-js": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^25.3.1",
    "@types/node-notifier": "^8.0.5",
    "commit-wand": "^1.0.22",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
